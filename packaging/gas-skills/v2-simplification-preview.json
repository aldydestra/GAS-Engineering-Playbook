{
  "schema_version": 1,
  "target_major": "v2",
  "principle": "one default front door, progressive disclosure, specialist knowledge retained",
  "default_entry_skill": "gas-engineering",
  "max_default_specialists": 2,
  "task_families": [
    {
      "id": "runtime-automation",
      "label": "Runtime & Automation",
      "primary": "gas-core-engineering",
      "specialists": ["performance-engineering", "testing-quality", "monitoring-observability"],
      "examples": ["trigger", "timeout", "checkpoint", "resume", "LockService", "quota", "retry"]
    },
    {
      "id": "architecture-data",
      "label": "Architecture & Data",
      "primary": "software-architecture",
      "specialists": ["database-engineering", "postgresql-integration"],
      "examples": ["layers", "repository", "schema", "PostgreSQL", "transaction", "sync"]
    },
    {
      "id": "web-ux",
      "label": "Web App & UX",
      "primary": "web-app-frontend-engineering",
      "specialists": ["product-design-engineering"],
      "examples": ["HtmlService", "google.script.run", "web app", "UI", "responsive", "accessibility"]
    },
    {
      "id": "workspace-integrations",
      "label": "Workspace Integrations",
      "primary": "workspace-addons-chat-engineering",
      "specialists": ["workspace-api-event-engineering"],
      "examples": ["add-on", "Chat", "CardService", "Workspace API", "Pub/Sub", "events"]
    },
    {
      "id": "security-release",
      "label": "Security & Release",
      "primary": "security-engineering",
      "specialists": ["deployment-engineering", "workspace-governance-compliance-engineering"],
      "examples": ["OAuth", "scope", "deployment", "clasp", "rollback", "policy", "data region"]
    },
    {
      "id": "migration-documentation",
      "label": "Migration & Documentation",
      "primary": "appsheet-migration",
      "specialists": ["documentation-engineering"],
      "examples": ["AppSheet migration", "handoff", "runbook", "ADR", "documentation"]
    }
  ]
}
