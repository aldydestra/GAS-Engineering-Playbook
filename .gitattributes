# Normalize line endings for cross-platform GAS skill development.
# Windows users can keep core.autocrlf enabled: the project files below
# will be stored and checked out with LF, including GitHub Actions YAML.
* text=auto
*.md        text eol=lf
*.py        text eol=lf
*.gs        text eol=lf
*.js        text eol=lf
*.ts        text eol=lf
*.json      text eol=lf
*.jsonl     text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.html      text eol=lf
*.css       text eol=lf
*.sh        text eol=lf
*.toml      text eol=lf
*.txt       text eol=lf
*.xml       text eol=lf
*.sql       text eol=lf
LICENSE     text eol=lf
.gitattributes text eol=lf
.gitignore     text eol=lf
**/SHA256SUMS text eol=lf

# Skill archives and other binary payloads must never be rewritten.
*.skill     binary
*.zip       binary
*.png       binary
*.jpg       binary
*.jpeg      binary
*.webp      binary
*.gif       binary
*.pdf       binary
*.ico       binary
